{
  "name": "@wc-kit/svelte",
  "version": "0.0.13",
  "description": "Svelte type definitions and helpers for @wc-kit/core web components",
  "keywords": [
    "components",
    "lit",
    "svelte",
    "ui",
    "wc-kit",
    "web-components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xianmua/wc-kit.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wc-kit/core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "svelte": "^5.0.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  }
}
