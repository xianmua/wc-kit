{
  "name": "@wc-kit/vue",
  "version": "0.0.3",
  "description": "Vue 3 type definitions and helpers for @wc-kit/core web components",
  "keywords": [
    "vue",
    "web-components",
    "lit",
    "ui",
    "components",
    "wc-kit"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xianmua/wui.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wc-kit/core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  }
}
