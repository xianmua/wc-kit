{
  "name": "@wc-kit/core",
  "version": "0.0.8",
  "description": "Framework-agnostic Web Components UI library built with Lit - 38 components, design tokens, dark mode and i18n",
  "license": "MIT",
  "keywords": [
    "component-library",
    "components",
    "custom-elements",
    "design-system",
    "lit",
    "ui",
    "wc",
    "wc-kit",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xianmua/wc-kit.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src/tokens/tokens.css",
    "src/styles/reset.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/components/**"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./reset.css": "./src/styles/reset.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "playground": "vite --config vite.playground.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "jsdom": "^26.0.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0"
  }
}
